# 공공데이터포털(data.go.kr) 일반 인증키 (Encoding 키 — % 포함 형태)
# https://www.data.go.kr/iim/api/selectAPIAcountView.do
VITE_DATA_GO_KR_SERVICE_KEY=

# 조회 기준: 제주시 탐라광장 (산지로 37, 위도 33.513825 / 경도 126.528389)

# 에어코리아 측정소명 — 탐라광장 인근 도시대기 측정소(제주시청·이도동)
VITE_AIR_STATION_NAME=이도동

# 기상청 격자 좌표 — 탐라광장 기준 (nx=53, ny=38)
VITE_WEATHER_NX=53
VITE_WEATHER_NY=38

# 새로고침 주기(ms) — 기본 10분
VITE_WEATHER_REFRESH_MS=600000

# 네이버 지도 (Dynamic Map ncpKeyId)
VITE_NAVER_NCP_KEY_ID=

# 매장 nearby API
VITE_STORE_API_BASE_URL=https://mac.kurl.kr:5001

# 비짓제주 OPEN API (서버/스크립트용 — VITE_ 접두어 없음, 브라우저 비노출)
# https://www.visitjeju.net/kr/visitJejuApi
VISITJEJU_OPENAPI_API_KEY=
VISITJEJU_OPENAPI_BASE_URL=https://api.visitjeju.net
